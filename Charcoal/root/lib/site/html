<body>

    [% content | none %]

    <!-- CSRF: auto-inject token into all POST forms that lack it -->
    <script>
    (function() {
        var meta = document.querySelector('meta[name="csrf-token"]');
        if (!meta) return;
        var token = meta.getAttribute('content');
        var forms = document.querySelectorAll('form[method="POST"], form[method="post"]');
        for (var i = 0; i < forms.length; i++) {
            if (!forms[i].querySelector('input[name="csrf_token"]')) {
                var inp = document.createElement('input');
                inp.type = 'hidden';
                inp.name = 'csrf_token';
                inp.value = token;
                forms[i].appendChild(inp);
            }
        }
    })();

    // Confirm dialog for forms with a data-confirm attribute.
    // The text comes from an HTML attribute, never from inline JS, so
    // quotes in user data cannot break out into script.
    document.addEventListener('submit', function(e) {
        var msg = e.target.getAttribute && e.target.getAttribute('data-confirm');
        if (msg && !window.confirm(msg)) { e.preventDefault(); }
    }, true);
    </script>
    
</body>
