            <div class="row">
                <div class="col-lg-12">
                    <h1 class="page-header">Edit Source Group Member</h1>
                    <h2>[% group.name %]</h2>
                </div>
                <!-- /.col-lg-12 -->
            </div>
            <!-- /.row -->
            <div class="row">
                <div class="col-lg-12">
                    <div class="panel panel-default">
                        <div class="panel-heading">
                        <p>Here you can modify the description for the below listed member of the group <b>[% group.name %].</b>
                        <br/>In order to change the member value (IP / Network), delete the user and create a new member.
                        </p>
                        </div>
                        <!-- /.panel-heading -->
                        <div class="panel-body">
                        <form name="editmemberform" role="form" action="[% c.uri_for(c.controller.action_for('editmember_submit'), [member.id, group.id]) %]" method="POST">
                            <fieldset>
                                <div class="form-group">
                                    <label for="desc">Member</label>
                                    <input type="text" class="form-control" name="value" id="value" required value="[% member.value %]" disabled>
                                </div>
                                
                                <div class="form-group">
                                    <label for="desc">Description</label>
                                    <input type="text" class="form-control" name="desc" id="desc" maxlength="64" required value="[% member.description %]">
                                </div>
                                
                                <input type="hidden" class="form-control" name="id" id="id" value="[% member.id %]">
                                <button type="submit" id=submit class="btn btn-success">Submit</button>
                                <a href="[% c.uri_for(c.controller.action_for('editmember'), [member.id, group.id]) %]" class="btn btn-warning" role="button" title="Reset">Reset</a>
                                
                            </fieldset>
                            
                        </form>
                        <!-- /. form -->

                        </div>
                        <!-- /.panel-body-->
                    </div>
                    <!-- /. panel -->
                </div>
            </div>
            <!-- /. row -->
