            <div class="row">
                <div class="col-lg-12">
                    <h1 class="page-header">Test ACL</h1>
                </div>
            </div>
            <div class="row">
                <div class="col-lg-12">
                    <div class="panel panel-default">
                        <div class="panel-heading">
                            Check what Charcoal does with a request: enter the source IP address of a device and a site.
                            <br/>The test asks charcoal-server, like the proxy does. After a rule change, the proxies can use
                            the old answer for up to 5 minutes, and the servers can be a few seconds behind.
                        </div>
                        <div class="panel-body">
                            <form method="GET" action="[% c.uri_for('/admin/tools/test') %]" class="form-horizontal">
                                <div class="form-group">
                                    <label for="ip" class="col-sm-2 control-label">Source IP</label>
                                    <div class="col-sm-4"><input type="text" class="form-control" id="ip" name="ip" value="[% form.ip %]" placeholder="10.0.0.25" required></div>
                                </div>
                                <div class="form-group">
                                    <label for="user" class="col-sm-2 control-label">User</label>
                                    <div class="col-sm-4"><input type="text" class="form-control" id="user" name="user" value="[% form.user %]" placeholder="optional"></div>
                                </div>
                                <div class="form-group">
                                    <label for="url" class="col-sm-2 control-label">Site</label>
                                    <div class="col-sm-6"><input type="text" class="form-control" id="url" name="url" value="[% form.url %]" placeholder="www.example.com or a URL" required></div>
                                </div>
                                <div class="form-group">
                                    <label class="col-sm-2 control-label">Protocol</label>
                                    <div class="col-sm-6">
                                        <label class="radio-inline"><input type="radio" name="proto" value="https" [% IF form.proto != 'http' %]checked[% END %]> HTTPS</label>
                                        <label class="radio-inline"><input type="radio" name="proto" value="http" [% IF form.proto == 'http' %]checked[% END %]> HTTP</label>
                                        <span class="help-block">A URL that starts with http:// or https:// sets the protocol.</span>
                                    </div>
                                </div>
                                <div class="form-group">
                                    <div class="col-sm-offset-2 col-sm-6">
                                        <button type="submit" class="btn btn-primary"><span class="glyphicon glyphicon-play"></span> Test</button>
                                    </div>
                                </div>
                            </form>

                            [% IF tested %]
                            <hr/>
                            <h3>Answer from charcoal-server</h3>
                            [% IF server_verdict %]
                                <p><span class="label label-[% server_verdict == 'ALLOW' ? 'success' : 'danger' %]" style="font-size:150%">[% server_verdict %]</span></p>
                            [% ELSE %]
                                <div class="alert alert-warning">[% server_error %]</div>
                            [% END %]

                            <h3>Why</h3>
                            [% IF threat %]
                            <div class="alert alert-danger">
                                Blocked by the threat feed <strong>[% threat %]</strong>: the site is on a list of known dangerous sites.
                                This check runs after the rules, also when a rule allows the site.
                            </div>
                            [% ELSIF server_verdict && server_verdict != explain.access %]
                            <div class="alert alert-warning">
                                The explanation below gives <strong>[% explain.access %]</strong>; the server answer <strong>[% server_verdict %]</strong> applies.
                                A recent rule change can cause this.
                            </div>
                            [% END %]
                            [% IF explain.rule %]
                            <p>
                                Rule: <span class="label label-[% explain.access == 'ALLOW' ? 'success' : 'danger' %]">[% explain.access %]</span>
                                <strong>[% explain.rule.name %]</strong> (position [% explain.rule.seq %])
                                [% IF explain.type == 'DEFAULT' %]
                                    &mdash; the default rule: no other rule matched.
                                [% END %]
                            </p>
                            [% IF explain.type == 'SPECIFIC' %]
                            <p>
                                Source: [% IF explain.via_src %]group <strong>[% explain.via_src %]</strong>[% ELSE %]<strong>ALL</strong>[% END %]
                                &middot; Destination: [% IF explain.via_dst %]group <strong>[% explain.via_dst.name %]</strong>, which contains <code>[% explain.via_dst.at %]</code>[% ELSE %]<strong>ALL</strong>[% END %]
                            </p>
                            [% IF !explain.via_src && !explain.via_dst %]
                            <div class="alert alert-danger">
                                This rule has source <strong>ALL</strong> and destination <strong>ALL</strong>. It matches almost every request,
                                so the rules below position [% explain.rule.seq %] rarely apply. If this is not intended, edit the rule and select its groups.
                            </div>
                            [% END %]
                            <p class="text-muted"><small>Charcoal checks every part of the name. Of all rules that match any part, the one highest in the list applies.</small></p>
                            [% END %]
                            [% ELSE %]
                            <div class="alert alert-danger">Your rules have no default rule (source ALL and destination ALL). Requests that match no rule are blocked.</div>
                            [% END %]

                            <p>Names checked: [% FOREACH l IN explain.walk %]<code>[% l %]</code>[% UNLESS loop.last %] &rarr; [% END %][% END %]</p>

                            <h4>Source groups that contain [% form.ip %][% IF form.user %] or user [% form.user %][% END %]</h4>
                            [% IF explain.groups.size %]
                                <ul>[% FOREACH g IN explain.groups %]<li><a href="[% c.uri_for('/admin/sourcegroups/listmembers', g.id) %]">[% g.name %]</a> <small class="text-muted">(entry [% g.value %])</small></li>[% END %]</ul>
                            [% ELSE %]
                                <p class="text-muted">None. Only rules with source ALL can apply.</p>
                            [% END %]

                            <h4>Destination groups that contain the site</h4>
                            [% IF categories.size %]
                            <table class="table table-condensed table-striped">
                                <thead><tr><th>Entry found</th><th>Group</th><th>Type</th><th>Used in your rules</th></tr></thead>
                                <tbody>
                                [% FOREACH r IN categories %]
                                    <tr>
                                        <td><code>[% r.matched %]</code></td>
                                        <td>[% IF r.members_url %]<a href="[% r.members_url %]">[% r.cat_name %]</a>[% ELSE %][% r.cat_name %][% END %]</td>
                                        <td>[% IF r.is_global %]<span class="label label-default">Global</span>[% ELSE %]<span class="label label-primary">Own</span>[% END %]</td>
                                        <td>[% IF r.rules.size %][% FOREACH rule IN r.rules %]<span class="label label-[% rule.access == 'ALLOW' ? 'success' : 'danger' %]">[% rule.access %]</span> [% rule.name %]<br/>[% END %][% ELSE %]<span class="text-muted">Not used</span>[% END %]</td>
                                    </tr>
                                [% END %]
                                </tbody>
                            </table>
                            [% ELSE %]
                                <p class="text-muted">None. Only rules with destination ALL can apply.</p>
                            [% END %]

                            <p><a data-toggle="collapse" href="#techDetails" aria-expanded="false" aria-controls="techDetails">
                                <span class="glyphicon glyphicon-wrench"></span> Technical details</a></p>
                            <div class="collapse" id="techDetails">
                                <table class="table table-condensed">
                                    <tr><th style="width:10em">Server</th><td><code>[% server_name %]</code></td></tr>
                                    <tr><th>Request</th><td><code style="word-break:break-all">[% request_line %]</code></td></tr>
                                    <tr><th>Reply</th><td>[% IF server_reply %]<code style="word-break:break-all">[% server_reply %]</code>[% ELSE %]<span class="text-muted">none</span>[% END %]</td></tr>
                                    [% IF server_verdict %][% IF server_error %]<tr><th>Error</th><td>[% server_error %]</td></tr>[% END %][% END %]
                                </table>
                            </div>
                            [% END %]
                        </div>
                    </div>
                </div>
            </div>
